// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Type {
  MODEL
  EXIT
}
enum Subject {
    PROGRAMMING
    DATA_STRUCTURES_ALGORITHMS
    OOP
    WEB_PROGRAMMING
    MOBILE_DEVELOPMENT
    DATABASE_SYSTEMS
    OPERATING_SYSTEMS
    SOFTWARE_ENGINEERING
    REQUIREMENTS_ENGINEERING
    ARCHITECTURE_DESIGN
    PROJECT_MANAGEMENT
    TESTING_QA
    EVOLUTION_MAINTENANCE
    NETWORKING
    AI_ML
}

model Examination {
  id        Int      @id @default(autoincrement())
  title     String?

  questions Question[]
  attempts  ExamAttempt[]
}

model Question {
  id         Int      @id @default(autoincrement()) 
  text       String
  subject    Subject
  type      Type     @default(MODEL)

  year       Int      @default(2019)
  from       String?
  is_flagged Boolean  @default(false)

  exam_id    Int?
  exam       Examination? @relation(fields: [exam_id], references: [id])

  choices    Choice[]

  // correct answer
  answer_id  Int?
  answer     Choice? @relation("CorrectAnswer", fields: [answer_id], references: [id])

  // user answers
  attempt_answers AttemptAnswer[]
}

model Choice {
  id           Int    @id @default(autoincrement())
  choice_text  String

  question_id  Int
  question     Question @relation(fields: [question_id], references: [id])

  // back relation for correct answer
  correct_for  Question[] @relation("CorrectAnswer")

  selected_in  AttemptAnswer[]
}

model ExamAttempt {
  id          Int      @id @default(autoincrement())

  exam_id     Int
  exam        Examination @relation(fields: [exam_id], references: [id])

  started_at  DateTime @default(now())
  finished_at DateTime?

  score       Int?

  answers     AttemptAnswer[]
}

model AttemptAnswer {
  id Int @id @default(autoincrement())

  attempt_id Int
  attempt    ExamAttempt @relation(fields: [attempt_id], references: [id])

  question_id Int
  question    Question @relation(fields: [question_id], references: [id])

  selected_choice_id Int?
  selected_choice    Choice? @relation(fields: [selected_choice_id], references: [id])

  is_correct Boolean?
}